{
  "name": "todo-server",
  "version": "1.0.0",
  "description": "REST API for react-todo — Express 5 + TypeScript + Prisma + JWT",
  "scripts": {
    "start": "node --import tsx src/index.ts",
    "dev": "node --env-file=.env --import tsx --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "tsc --noEmit && eslint .",
    "format": "prettier --write .",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma",
    "jwt",
    "postgresql",
    "rest-api"
  ],
  "type": "commonjs",
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-serve-static-core": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
